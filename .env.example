# Opcional: variables de docker-compose.yml (instalación local con Docker).
# docker compose funciona SIN este archivo: todos los valores tienen un default.
# Para personalizarlos:  cp .env.example .env   (en Windows: copy .env.example .env)
#
# Valores de desarrollo ficticios. NO son credenciales de producción
# (producción usa Render + Neon, configurados en sus paneles).

# Puertos en tu equipo
WEB_PORT=8080
API_PORT=4100

# PostgreSQL local (solo accesible dentro de la red de Docker)
POSTGRES_DB=vokter
POSTGRES_USER=vokter
POSTGRES_PASSWORD=vokter_local_password

# Secreto JWT del backend local
JWT_SECRET=solo_para_docker_local_no_usar_en_produccion

# Descarga del APK en /descarga (Release público de GitHub)
VITE_APK_URL=https://github.com/Brayabn/vokter/releases/download/v1.0.0/VOKTER-Android-v1.0.0.apk
VITE_APK_VERSION=1.0.0
