# Copia este archivo como .env. En producción (Vercel) se definen en
# Project Settings → Environment Variables y se aplican al COMPILAR.

# URL del API (termina en /api). Producción: https://<servicio>.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# URL pública del APK (GitHub Release). Debe ser HTTPS; si falta, /descarga
# muestra "Descarga no disponible" en lugar de un QR o botón falsos.
VITE_APK_URL=

# Versión mostrada en /descarga (debe coincidir con mobile/app.json → expo.version)
VITE_APK_VERSION=1.0.0
