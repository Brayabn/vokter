# Copia este archivo como .env. En producción (Vercel) se definen en
# Project Settings → Environment Variables y se aplican al COMPILAR.

# URL del API (termina en /api). Producción: https://<servicio>.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# URL pública del APK (GitHub Release). Debe ser HTTPS; si falta, /descarga
# muestra "Descarga no disponible" en lugar de un QR o botón falsos.
VITE_APK_URL=

# OPCIONAL. La versión que se muestra en /descarga se deduce de la etiqueta que
# lleva VITE_APK_URL (.../releases/download/v1.0.0/...), para que la página no
# pueda anunciar una versión distinta del archivo que entrega. Solo se usa este
# valor si la URL no lleva etiqueta; si se contradicen, gana la de la URL y se
# avisa por consola.
VITE_APK_VERSION=
