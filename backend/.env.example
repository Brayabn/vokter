# Copia este archivo como .env y ajusta los valores.

# Puerto HTTP del API
PORT=4000

# Secreto para firmar los JWT. Usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# Ruta del archivo SQLite (relativa a la carpeta backend/)
DB_STORAGE=./data/vokter.sqlite

# Origen permitido por CORS (URL de la web)
CORS_ORIGIN=http://localhost:5173
