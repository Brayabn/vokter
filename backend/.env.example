# Copia este archivo como .env y ajusta los valores.
# En producción (Render) estas variables se definen en el panel/Blueprint, no en un archivo.

# development | production  (en production se validan JWT_SECRET, DATABASE_URL y CORS_ORIGIN)
NODE_ENV=development

# Puerto HTTP del API (Render lo asigna automáticamente)
PORT=4000

# Secreto para firmar los JWT (mínimo 32 caracteres en producción). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplaza_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# Base de datos:
#  - Producción: PostgreSQL (Neon). Cadena de conexión con sslmode=require.
#      DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
#  - Desarrollo: si DATABASE_URL está vacía se usa SQLite en DB_STORAGE.
DATABASE_URL=
DB_STORAGE=./data/vokter.sqlite
# Solo para un PostgreSQL local sin TLS (p. ej. Docker): DATABASE_SSL=false

# Orígenes permitidos por CORS (URL de la web), separados por coma.
CORS_ORIGIN=http://localhost:5173

# true = al arrancar crea los datos demo que falten (idempotente, no duplica)
SEED_DEMO_DATA=true
